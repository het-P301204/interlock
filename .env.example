# INTERLOCK configuration. Copy to .env (never commit .env). Every variable is
# optional; the defaults below are what the server uses when it is unset.

# --- HTTP -------------------------------------------------------------------
# PORT=8787
# Bind address. Loopback by default; the container image sets 0.0.0.0.
# HOST=127.0.0.1
# Host header names the server answers for (DNS-rebinding protection), comma
# separated. Default: 127.0.0.1,localhost,[::1] when HOST is loopback, any
# otherwise. Set it to your public host name in production; "*" disables the check.
# INTERLOCK_ALLOWED_HOSTS=interlock.example.com
# Origins allowed to call the API cross-origin (CORS is off by default: the web
# app is served from the same origin). Comma separated.
# INTERLOCK_ALLOWED_ORIGINS=https://review.example.com
# Number of trusted reverse proxies that append to X-Forwarded-For (rate limiting
# uses the client address that many entries from the right).
# INTERLOCK_TRUST_PROXY_HOPS=0

# --- Authentication -----------------------------------------------------------
# Optional bearer token. When set (min. 16 characters), every /api route except
# /api/health requires "Authorization: Bearer <token>". Generate a long random
# value, e.g.  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
INTERLOCK_API_TOKEN=

# --- Storage ------------------------------------------------------------------
# SQLite database at $INTERLOCK_DATA_DIR/interlock.db (relative paths resolve
# from the repository root). The container image uses /data.
# INTERLOCK_DATA_DIR=.data
# "memory" keeps everything in memory (tests, CI, throwaway demos).
# INTERLOCK_DB=memory

# --- Analysis limits ------------------------------------------------------------
# Largest accepted project upload, in MB (enforced while the body streams in).
# INTERLOCK_MAX_UPLOAD_MB=64
# Wall-clock limit per engine job (parse, analysis, drift); the worker is stopped
# and the request answered with 504 when it is exceeded.
# INTERLOCK_ANALYSIS_TIMEOUT_MS=60000
# Heap limit for each analysis worker thread, in MB.
# INTERLOCK_WORKER_MAX_MEMORY_MB=512
# Engine jobs running at once; more are refused with 503 ANALYSIS_BUSY.
# INTERLOCK_MAX_CONCURRENT_ANALYSES=2
# Uploads + analyses + drift requests per client address per minute (other API
# calls get 20x this budget).
# INTERLOCK_RATE_LIMIT_PER_MINUTE=60

# --- Operations -------------------------------------------------------------------
# debug | info | warn | error | silent. Logs are JSON lines and never contain
# request bodies, file contents or tokens.
# INTERLOCK_LOG_LEVEL=info
# Built web app served in --production.
# INTERLOCK_WEB_DIST=apps/web/dist
# NODE_ENV=production also enables --production behaviour (HSTS, static serving).

# --- Smoke test (scripts/smoke.ts) ------------------------------------------------
# INTERLOCK_SMOKE_TOKEN=
# INTERLOCK_SMOKE_API_ONLY=false
