</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Trip" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Any trip cause present]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Any trip cause sets Trip. Non-latching: the MCC starter drops out and the sequencer must re-request once the cause clears.]]>
</Comment>
<Text>
<![CDATA[[XIC(Level_HH) ,XIC(Press_Trip) ,XIC(Motor_Temp_Hi) ,XIC(ESD_Active) ]OTE(Trip);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Run enable: requested and no trip present.]]>
</Comment>
<Text>
<![CDATA[XIC(Run_Request)XIO(Trip)OTE(Run_Enable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Shutdown alarm follows the trip.]]>
</Comment>
<Text>
<![CDATA[XIC(Trip)OTE(Shutdown_Alarm);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
