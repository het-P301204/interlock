<Programs>
<Program Name="Safety" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<![CDATA[Station protective functions: ESD, T-101 overflow protection, pump start permissive. Any change requires MOC and functional test per NWA-ENG-014.]]>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<![CDATA[Protective function dispatcher]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Emergency shutdown chain.]]>
</Comment>
<Text>
<![CDATA[JSR(ESD,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Wet well T-101 overflow protection.]]>
</Comment>
<Text>
<![CDATA[JSR(Overflow,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Station pump start permissive.]]>
</Comment>
<Text>
<![CDATA[JSR(Permissives,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESD" Type="RLL">
<Description>
<![CDATA[Emergency shutdown (SF-01)]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MCC-1 main enable. Drops on loss of the E-stop loop (ES-1..ES-4 via SR-1), remote ESD from the gatehouse, or fire panel FACP-1 alarm. De-energize to trip.]]>
</Comment>
<Text>
<![CDATA[XIC(EStop_Healthy)XIO(ESD_Remote_Cmd)XIO(Fire_Detected)OTE(MCC_Main_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[ESD active status to every pump interlock and to SCADA.]]>
</Comment>
<Text>
<![CDATA[XIO(MCC_Main_Enable)OTE(ESD_Active);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Overflow" Type="RLL">
<Description>
<![CDATA[T-101 overflow protection (SF-05)]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[LSHH-101 closes inlet valve XV-101 (energize to close). Hardwired float, independent of the LT-101 transmitter.]]>
</Comment>
<Text>
<![CDATA[XIC(LSHH_101)OTE(XV101_Close_Cmd);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Permissives" Type="RLL">
<Description>
<![CDATA[Pump start permissive (SF-08)]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Pumps may start only with MCC-1 enabled, wet well below high-high, and suction header above 12 psig (NPSH margin).]]>
</Comment>
<Text>
<![CDATA[XIC(MCC_Main_Enable)XIO(LSHH_101)GRT(Suction_Press_PV,12.0)OTE(Pump_Start_Permissive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
