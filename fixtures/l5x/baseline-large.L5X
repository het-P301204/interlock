<Description>
<![CDATA[Building services dispatcher]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Panel and yard lighting.]]>
</Comment>
<Text>
<![CDATA[JSR(Lighting,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
