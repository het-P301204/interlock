<Program Name="Compressor" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<![CDATA[Air compressor C-201 (bubbler and instrument air): high pressure shutdown, low suction trip.]]>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<![CDATA[C-201 control and protection (SF-06)]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[C-201 high pressure shutdown. PSH-201 trips the compressor while station safety functions are armed.]]>
</Comment>
<Text>
<![CDATA[XIC(PT201_High)XIC(Safety_Enable)OTE(C201_Shutdown_Cmd);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[C-201 motor run: operator run command, blocked while the shutdown is active.]]>
</Comment>
<Text>
<![CDATA[XIC(C201_Run_Cmd)XIO(C201_Shutdown_Cmd)OTE(C201_Motor_Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Low suction pressure: 2 s filter on PT-201S below 3.5 psig.]]>
</Comment>
<Text>
<![CDATA[LES(C201_Suction_PV,3.5)TON(C201_LP_Delay,2000,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[C-201 low suction trip after delay.]]>
</Comment>
<Text>
<![CDATA[XIC(C201_LP_Delay.DN)OTE(C201_Low_Press_Trip);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Alarms" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<![CDATA[Annunciation to the HMI alarm summary and the control room horn.]]>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<![CDATA[Station alarms (SF-07)]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[T-101 high-high level alarm from LSHH-101 to HMI alarm summary, severity 900 (urgent).]]>
</Comment>
<Text>
<![CDATA[XIC(LSHH_101)ALMD(LT101_HH_Alm,0,0,0,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[C-201 high pressure shutdown alarm.]]>
</Comment>
<Text>
<![CDATA[XIC(C201_Shutdown_Cmd)ALMD(C201_Shutdown_Alm,0,0,0,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Control room horn and beacon AH-1 while MCC-1 is tripped.]]>
</Comment>
<Text>
<![CDATA[XIO(MCC_Main_Enable)OTE(ESD_Trip_Horn);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Auxiliary" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<![CDATA[Station auxiliaries: P-104 seal water, drywell sump.]]>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<![CDATA[Auxiliaries dispatcher]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[P-104 seal water.]]>
</Comment>
<Text>
<![CDATA[JSR(SealWater,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Drywell sump.]]>
</Comment>
<Text>
<![CDATA[JSR(Sump,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SealWater" Type="RLL">
<Description>
<![CDATA[P-104 seal water supply]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Seal water solenoid SV-104 opens while P-104 runs. Held closed on seal water tank low level (LSL-104) so the booster does not run dry.]]>
</Comment>
<Text>
<![CDATA[XIC(Pump_04_Run_Enable)XIO(Seal_Water_Low)OTE(Seal_Water_Valve_Open);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Sump" Type="RLL">
<Description>
<![CDATA[Drywell sump pump SP-1]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Drywell sump pump SP-1 runs on sump high level LSH-120.]]>
</Comment>
<Text>
<![CDATA[XIC(Sump_Level_Hi)OTE(Sump_Pump_Run);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Utilities" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
