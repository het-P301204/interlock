<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="AOI_PumpInterlock" Revision="3.4" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2019-04-08T13:20:41.517Z" CreatedBy="NWA\controls" EditedDate="2026-03-02T10:41:05.880Z" EditedBy="NWA\controls" SoftwareRevision="v35.00" Vendor="Northgate Water Authority">
<Description>
<![CDATA[Wet well pump protection interlock. Any trip cause drops Run_Enable to the MCC starter; Shutdown_Alarm follows the trip for HMI annunciation. Standard NWA pump block, do not edit at site level.]]>
</Description>
<RevisionNote>
<![CDATA[3.4 adds ESD_Active input so a station ESD trips every pump through the block (MOC-2024-017).]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
