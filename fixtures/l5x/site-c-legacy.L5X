<Programs>
<Program Name="Safety" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Station protective functions: ESD, T-101 overflow protection, pump start permissive. Any change requires MOC and functional test per NWA-ENG-014.]]>
</LocalizedDescription>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Protective function dispatcher]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Emergency shutdown chain.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(ESD,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Wet well T-101 overflow protection.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(Overflow,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Station pump start permissive.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(Permissives,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ESD" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Emergency shutdown (SF-01)]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[MCC-1 main enable. Drops on loss of the E-stop loop (ES-1..ES-4 via SR-1), remote ESD from the gatehouse, or fire panel FACP-1 alarm. De-energize to trip.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(EStop_Healthy)XIO(ESD_Remote_Cmd)XIO(Fire_Detected)OTE(MCC_Main_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[ESD active status to every pump interlock and to SCADA.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIO(MCC_Main_Enable)OTE(ESD_Active);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Overflow" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[T-101 overflow protection (SF-05)]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[LSHH-101 closes inlet valve XV-101 (energize to close). Hardwired float, independent of the LT-101 transmitter.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(LSHH_101)OTE(XV101_Close_Cmd);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Permissives" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Pump start permissive (SF-08)]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Pumps may start only with MCC-1 enabled, wet well below high-high, and suction header above 12 psig (NPSH margin).]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(MCC_Main_Enable)XIO(LSHH_101)GRT(Suction_Press_PV,12.0)OTE(Pump_Start_Permissive);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="PumpControl" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Wet well pumps P-101 to P-105: one AOI_PumpInterlock instance per pump, run enable to the MCC.]]>
</LocalizedDescription>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Pump routine dispatcher]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-101 interlock and control.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(PUMP_01,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-102 interlock and control.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(PUMP_02,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-103 interlock and control.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(PUMP_03,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-104 interlock and control.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(PUMP_04,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-105 interlock and control.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(PUMP_05,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PUMP_01" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[P-101 wet well pump control]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-101 protection interlock. Trips on LSHH-101, discharge pressure high or motor over-temperature. Run enable to MCC-1 cubicle 1A.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[AOI_PumpInterlock(PUMP_01_IL,Pump_01_Run_Request,LSHH_101,Pump_01_Disch_Press_Hi,Pump_01_Motor_Temp_Hi,Pump_01_Run_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-101 protective shutdown alarm to HMI alarm summary.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(PUMP_01_IL.Shutdown_Alarm)OTE(Pump_01_Shutdown_Alarm);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PUMP_02" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[P-102 wet well pump control]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-102 protection interlock. Trips on LSHH-101, discharge pressure high or motor over-temperature. Run enable to MCC-1 cubicle 2A.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[AOI_PumpInterlock(PUMP_02_IL,Pump_02_Run_Request,LSHH_101,Pump_02_Disch_Press_Hi,Pump_02_Motor_Temp_Hi,Pump_02_Run_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-102 protective shutdown alarm to HMI alarm summary.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(PUMP_02_IL.Shutdown_Alarm)OTE(Pump_02_Shutdown_Alarm);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PUMP_03" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[P-103 wet well pump control]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-103 protection interlock. Trips on LSHH-101, suction pressure low or motor over-temperature. Run enable to MCC-1 cubicle 3A.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[AOI_PumpInterlock(PUMP_03_IL,Pump_03_Run_Request,LSHH_101,Pump_03_Suction_Low,Pump_03_Motor_Temp_Hi,Pump_03_Run_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-103 protective shutdown alarm to HMI alarm summary.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(PUMP_03_IL.Shutdown_Alarm)OTE(Pump_03_Shutdown_Alarm);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PUMP_04" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[P-104 wet well pump control]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-104 protection interlock. Trips on LSHH-101, discharge pressure high or motor over-temperature. Run enable to MCC-1 cubicle 4A.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[AOI_PumpInterlock(PUMP_04_IL,Pump_04_Run_Request,LSHH_101,Pump_04_Disch_Press_Hi,Pump_04_Motor_Temp_Hi,Pump_04_Run_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-104 protective shutdown alarm to HMI alarm summary.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(PUMP_04_IL.Shutdown_Alarm)OTE(Pump_04_Shutdown_Alarm);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PUMP_05" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[P-105 wet well pump control]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-105 protection interlock. Trips on LSHH-101, discharge pressure high or motor over-temperature. Run enable to MCC-1 cubicle 5A.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[AOI_PumpInterlock(PUMP_05_IL,Pump_05_Run_Request,LSHH_101,Pump_05_Disch_Press_Hi,Pump_05_Motor_Temp_Hi,Pump_05_Run_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-105 protective shutdown alarm to HMI alarm summary.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(PUMP_05_IL.Shutdown_Alarm)OTE(Pump_05_Shutdown_Alarm);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Compressor" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Air compressor C-201 (bubbler and instrument air): high pressure shutdown, low suction trip.]]>
</LocalizedDescription>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[C-201 control and protection (SF-06)]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[C-201 high pressure shutdown. PSH-201 trips the compressor while station safety functions are armed.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(PT201_High)XIC(Safety_Enable)OTE(C201_Shutdown_Cmd);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[C-201 motor run: operator run command, blocked while the shutdown is active.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(C201_Run_Cmd)XIO(C201_Shutdown_Cmd)OTE(C201_Motor_Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Low suction pressure: 2 s filter on PT-201S below 3.5 psig.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[LES(C201_Suction_PV,3.5)TON(C201_LP_Delay,2000,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[C-201 low suction trip after delay.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(C201_LP_Delay.DN)OTE(C201_Low_Press_Trip);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Alarms" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Annunciation to the HMI alarm summary and the control room horn.]]>
</LocalizedDescription>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Station alarms (SF-07)]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[T-101 high-high level alarm from LSHH-101 to HMI alarm summary, severity 900 (urgent).]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(LSHH_101)ALMD(LT101_HH_Alm,0,0,0,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[C-201 high pressure shutdown alarm.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(C201_Shutdown_Cmd)ALMD(C201_Shutdown_Alm,0,0,0,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Control room horn and beacon AH-1 while MCC-1 is tripped.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIO(MCC_Main_Enable)OTE(ESD_Trip_Horn);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Auxiliary" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Station auxiliaries: P-104 seal water, drywell sump.]]>
</LocalizedDescription>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Auxiliaries dispatcher]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-104 seal water.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(SealWater,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Drywell sump.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(Sump,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SealWater" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[P-104 seal water supply]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Seal water solenoid SV-104 opens while P-104 runs. Held closed on seal water tank low level (LSL-104) so the booster does not run dry.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(Pump_04_Run_Enable)XIO(Seal_Water_Low)OTE(Seal_Water_Valve_Open);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Sump" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Drywell sump pump SP-1]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Drywell sump pump SP-1 runs on sump high level LSH-120.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(Sump_Level_Hi)OTE(Sump_Pump_Run);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Utilities" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
