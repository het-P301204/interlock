<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="AOI_PumpInterlock" Revision="3.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2019-04-08T13:20:41.517Z" CreatedBy="NWA\controls" EditedDate="2021-09-07T08:55:12.340Z" EditedBy="NWA\controls" SoftwareRevision="v33.01" Vendor="Northgate Water Authority">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Wet well pump protection interlock. Any trip cause drops Run_Enable to the MCC starter; Shutdown_Alarm follows the trip for HMI annunciation.]]>
</LocalizedDescription>
</Description>
<RevisionNote>
<![CDATA[3.1 adds Motor_Temp_Hi input (thermistor relays fitted on all pumps).]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Enable Input - System Defined Parameter]]>
</LocalizedDescription>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Enable Output - System Defined Parameter]]>
</LocalizedDescription>
</Description>
</Parameter>
