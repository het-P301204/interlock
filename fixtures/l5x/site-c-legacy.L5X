<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Building services dispatcher]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Panel and yard lighting.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(Lighting,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Pump room ventilation.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[JSR(HVAC,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Lighting" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Panel and yard lighting]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Maintenance mode lamp on CP-1.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(Maintenance_Mode)OTE(Panel_Light_Maint);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Yard lights on photocell PE-1.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(Dusk_Sensor)OTE(Yard_Lights);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="HVAC" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Pump room ventilation]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[Exhaust fan EF-1 on pump room high temperature.]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(Building_Temp_Hi)OTE(Exhaust_Fan_Run);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Reporting" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Run hours for the SCADA historian. Declared non-safety.]]>
</LocalizedDescription>
</Description>
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Run-hour accumulation]]>
</LocalizedDescription>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-101 run hours (RTO, 1 h base, rolled over by historian).]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(Pump_01_Run_Enable)RTO(Pump_01_Hours,3600000,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<LocalizedComment Lang="en-US">
<![CDATA[P-102 run hours (RTO, 1 h base, rolled over by historian).]]>
</LocalizedComment>
</Comment>
<Text>
<![CDATA[XIC(Pump_02_Run_Enable)RTO(Pump_02_Hours,3600000,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[Continuous scan: protective functions first, then pumps, compressor, alarms and station services.]]>
</LocalizedDescription>
</Description>
<ScheduledPrograms>
<ScheduledProgram Name="Safety"/>
<ScheduledProgram Name="PumpControl"/>
<ScheduledProgram Name="Compressor"/>
<ScheduledProgram Name="Alarms"/>
<ScheduledProgram Name="Auxiliary"/>
<ScheduledProgram Name="Utilities"/>
</ScheduledPrograms>
</Task>
<Task Name="Slow_100ms" Type="PERIODIC" Rate="100" Priority="12" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<Description>
<LocalizedDescription Lang="en-US">
<![CDATA[100 ms periodic: run hours and totals for the SCADA historian.]]>
</LocalizedDescription>
</Description>
<ScheduledPrograms>
<ScheduledProgram Name="Reporting"/>
</ScheduledPrograms>
</Task>
</Tasks>
<CST MasterID="0"/>
<WallClockTime LocalTimeAdjustment="0" TimeZone="0"/>
<Trends/>
<DataLogs/>
<TimeSynchronize Priority1="128" Priority2="128" PTPEnable="false"/>
<EthernetPorts>
<EthernetPort Port="1" Label="1" PortEnabled="true"/>
</EthernetPorts>
</Controller>
</RSLogix5000Content>
